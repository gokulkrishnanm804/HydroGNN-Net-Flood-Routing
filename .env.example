# HydroGNN-Net System Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, zero-config local dev):
DATABASE_URL=sqlite:///hydrognn.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/hydrognn

# ── JWT Security ──────────────────────────────────────────────────────────────
SECRET_KEY=your_jwt_secret_key_here_change_in_production
ALGORITHM=HS256

# ── External API Keys ─────────────────────────────────────────────────────────
# OpenWeather — free tier at https://openweathermap.org/api
# Free keys available at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA Earthdata — needed for HLS/NDVI satellite scenes (optional)
NASA_EARTHDATA_USERNAME=your_nasa_earthdata_username
NASA_EARTHDATA_PASSWORD=your_nasa_earthdata_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to talk to backend
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# ── Scheduler ─────────────────────────────────────────────────────────────────
# How often the background scheduler fetches live data (seconds)
SCHEDULER_INTERVAL_SEC=900
RETRAINING_INTERVAL_DAYS=7

# ── Copernicus CDS (ERA5) ─────────────────────────────────────────────────────
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your_copernicus_cds_key_here
